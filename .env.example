# ============================================================
# Voice Agent Configuration
# ============================================================

# ------------------------------------------------------------
# LLM settings (required - your OpenAI-compatible API)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# For local vLLM/Ollama, use something like:
# OPENAI_BASE_URL=http://your-server:8000/v1
# OPENAI_MODEL=your-model-name
# OPENAI_API_KEY=not-needed

# ------------------------------------------------------------
# STT settings (Speech-to-Text)
# Default: faster-whisper running locally in Docker (free)
# ------------------------------------------------------------
OPENAI_STT_MODEL=Systran/faster-whisper-base
OPENAI_STT_BASE_URL=http://whisper:8000/v1

# To use OpenAI Whisper API instead:
# OPENAI_STT_MODEL=whisper-1
# OPENAI_STT_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# TTS settings (Text-to-Speech)
# Default: Edge TTS running locally in Docker (free)
# ------------------------------------------------------------
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_BASE_URL=http://tts:8082/v1

# Available Edge TTS voices:
# alloy   -> en-US-AriaNeural
# echo    -> en-US-GuyNeural
# fable   -> en-GB-SoniaNeural
# onyx    -> en-US-DavisNeural
# nova    -> en-US-JennyNeural
# shimmer -> en-US-AmberNeural

# To use OpenAI TTS API instead:
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# LiveKit settings
# ------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://livekit-server:7880
